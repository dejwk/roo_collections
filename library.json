{
    "name": "roo_collections",
    "description": "Compact flat hash maps and sets for ESP32 and other microcontrollers. Build immutable lookup tables at compile time with C++17.",
    "keywords": ["esp32", "embedded", "hashmap", "hashset", "hashtable", "constexpr"],
    "authors": [
        {
            "name": "Dawid Kurzyniec",
            "email": "dawid.kurzyniec@gmail.com",
            "maintainer": true
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/dejwk/roo_collections"
    },
    "version": "2.0.0",
    "homepage": "https://github.com/dejwk/roo_collections",
    "frameworks": [
        "Arduino",
        "*"
    ],
    "build": {
        "srcDir": "src",
        "srcFilter": "+<*> -<examples> -<test>"
    },
    "dependencies": {
        "dejwk/roo_backport": ">=1.2.4"
    },
    "export": {
        "include": [
            "src/",
            "examples/",
            "README.md",
            "RELEASE_NOTES.md",
            "LICENSE",
            "library.json",
            "library.properties"
        ]
    }
}
