{
    "name": "roo_collections",
    "description": "Memory-conscious collections, supporting flat small hashtables, hash maps, and hash sets.",
    "keywords": "hashtable hashmap hashset",
    "authors": [
        {
            "name": "Dawid Kurzyniec",
            "email": "dawid.kurzyniec@gmail.com",
            "maintainer": true
        }
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/dejwk/roo_collections"
    },
    "version": "1.4.9",
    "homepage": "https://github.com/dejwk/roo_collections",
    "frameworks": [
        "Arduino",
        "*"
    ],
    "build": {
        "srcDir": "src",
        "srcFilter": "+<*> -<examples> -<test>"
    },
    "dependencies": {
        "dejwk/roo_backport": ">=1.2.4"
    },
    "export": {
        "include": [
            "src/",
            "examples/",
            "README.md",
            "RELEASE_NOTES.md",
            "LICENSE",
            "library.json",
            "library.properties"
        ]
    }
}
